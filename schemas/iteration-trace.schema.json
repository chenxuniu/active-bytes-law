{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chenxuniu/active-bytes-law/schemas/iteration-trace.schema.json",
  "title": "Active-Bytes decode iteration",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "episode_id",
    "iteration_id",
    "monotonic_start_ns",
    "monotonic_end_ns",
    "active_request_ids",
    "useful_tokens_by_request",
    "metered_useful_output_tokens",
    "attended_length_by_request",
    "live_kv_blocks",
    "allocated_kv_blocks",
    "accepted_tokens",
    "rejected_tokens",
    "speculative_draft_tokens",
    "preemptions",
    "swaps",
    "recomputed_tokens",
    "prefix_cache_hits",
    "offloaded_bytes",
    "scheduler_mode",
    "attention_backend",
    "graph_mode",
    "kv_cache_dtype",
    "weight_dtype"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "episode_id": {"type": "integer", "minimum": 0},
    "iteration_id": {"type": "integer", "minimum": 0},
    "monotonic_start_ns": {"type": "integer", "minimum": 0},
    "monotonic_end_ns": {"type": "integer", "minimum": 0},
    "active_request_ids": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "useful_tokens_by_request": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "metered_useful_output_tokens": {"type": "integer", "minimum": 0},
    "runtime_seq_len_raw_by_request": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "attended_length_by_request": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "live_kv_blocks": {"type": "integer", "minimum": 0},
    "allocated_kv_blocks": {"type": "integer", "minimum": 0},
    "accepted_tokens": {"type": "integer", "minimum": 0},
    "rejected_tokens": {"type": "integer", "minimum": 0},
    "speculative_draft_tokens": {"type": "integer", "minimum": 0},
    "preemptions": {"type": "integer", "minimum": 0},
    "swaps": {"type": "integer", "minimum": 0},
    "recomputed_tokens": {"type": "integer", "minimum": 0},
    "prefix_cache_hits": {"type": "integer", "minimum": 0},
    "offloaded_bytes": {"type": "integer", "minimum": 0},
    "scheduler_mode": {"type": "string", "minLength": 1},
    "attention_backend": {"type": "string", "minLength": 1},
    "graph_mode": {"type": "string", "minLength": 1},
    "kv_cache_dtype": {"type": "string", "minLength": 1},
    "weight_dtype": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
