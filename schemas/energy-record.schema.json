{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chenxuniu/active-bytes-law/schemas/energy-record.schema.json",
  "title": "Active-Bytes decode energy episode",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "cell_id",
    "repeat",
    "episode_id",
    "boundary",
    "sensor",
    "counter_start_mj",
    "counter_end_mj",
    "counter_read_start_monotonic_ns",
    "go_monotonic_ns",
    "decode_done_monotonic_ns",
    "counter_read_end_monotonic_ns",
    "metered_useful_tokens",
    "decode_seconds",
    "qc_pass"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "cell_id": {"type": "string", "minLength": 1},
    "repeat": {"type": "integer", "minimum": 1},
    "episode_id": {"type": "integer", "minimum": 0},
    "boundary": {"const": "decode-only"},
    "sensor": {"const": "DCGM_FI_DEV_TOTAL_ENERGY"},
    "counter_start_mj": {"type": "number", "minimum": 0},
    "counter_end_mj": {"type": "number", "minimum": 0},
    "counter_read_start_monotonic_ns": {"type": "integer", "minimum": 0},
    "go_monotonic_ns": {"type": "integer", "minimum": 0},
    "decode_done_monotonic_ns": {"type": "integer", "minimum": 0},
    "counter_read_end_monotonic_ns": {"type": "integer", "minimum": 0},
    "metered_useful_tokens": {"type": "integer", "minimum": 1},
    "decode_seconds": {"type": "number", "exclusiveMinimum": 0},
    "integrated_power_joules": {"type": "number", "minimum": 0},
    "qc_pass": {"type": "boolean"},
    "qc_reasons": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
